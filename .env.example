# .env.example — every variable the project understands, with DUMMY values. COMMITTED.
# It is how the next person knows what to set. Copy the ones you need into .env.local
# (git-ignored) and give them real values. Run `npm run check:env` to verify this list is complete.

# ── Public (NEXT_PUBLIC_) — inlined into the browser bundle at BUILD time, readable by anyone ──
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Leave empty to load no third-party script. Example: https://analytics.example/s.js
NEXT_PUBLIC_ANALYTICS_SRC=

# ── Server only — never prefix these with NEXT_PUBLIC_ ──
# Secure cookies work on http://localhost. If you test from a phone over a LAN address such as
# http://192.168.1.20:3000 the browser refuses them: set this to false for that test only,
# and never in production.
COOKIE_SECURE=true

# ── Not used yet (later modules). Dummy values only. ──
# DATABASE_URL=postgres://user:password@localhost:5432/addis_eats
# SESSION_SECRET=replace-me-with-32-random-characters
# TELEBIRR_SECRET=replace-me
